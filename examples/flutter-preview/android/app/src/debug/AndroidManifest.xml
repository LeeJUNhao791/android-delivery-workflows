<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application android:networkSecurityConfig="@xml/preview_network">
        <activity android:name=".MainActivity" android:enabled="false" />
        <activity android:name=".BridgeActivity" android:exported="true" android:theme="@style/NormalTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="io.github.leejunhao791.deliverydemo.NativePreviewActivity" android:exported="false" />
    </application>
</manifest>
